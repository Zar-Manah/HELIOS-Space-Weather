# Local-only safety net. This file does not create a repository; it only tells any
# future publishing step what must never travel.

# Python junk
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.ipynb_checkpoints/

# OS junk
.DS_Store
Thumbs.db

# Raw observations. The six processed inputs in data/processed/ DO travel,
# and so does models/v3/ with its checksum manifest.
data/raw/

# Local environment
.venv/
venv/
.env
